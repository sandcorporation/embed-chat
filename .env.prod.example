# ── 프로덕션(oracle A1) 배포용 환경변수 — /opt/embed-chat/.env 로 복사해 채운다 ──────────────
# docs/deployment.md 참조. 이미지·git에 절대 커밋하지 말 것(.env는 gitignore).

# 반드시 prod 설정 모듈을 지정 — 없으면 dev 설정으로 떠서 DEBUG·평문키·SQLite류 위험.
DJANGO_SETTINGS_MODULE=config.settings.prod

# ⚠️ SECRET_KEY는 Django 시크릿이자 '테넌트 provider API 키 암호화(Fernet) 키'의 파생원이다
#    (apps/tenants/crypto.py). 한번 정하면 절대 바꾸지 말 것 — 바꾸면 저장된 모든 테넌트 키가
#    복호화 불가가 된다. 생성: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me-strong-random-and-never-rotate

# 서비스 도메인(NPM이 종단). 쉼표로 여러 개.
# ⚠️ 127.0.0.1·localhost를 반드시 포함 — 컨테이너 healthcheck와 배포 스모크가 /api/health를
#    127.0.0.1로 치는데, 빠지면 Django가 400(DisallowedHost)을 내 rollout/스모크가 실패한다.
ALLOWED_HOSTS=chat.example.com,127.0.0.1,localhost
# https 출처(JWT API라 비필수지만 명시 권장). 예: https://chat.example.com
CSRF_TRUSTED_ORIGINS=https://chat.example.com

# ── Database (compose의 db 서비스) — DB_NAME/USER/PASSWORD는 db 컨테이너 초기화에도 쓰인다 ──
DB_HOST=db
DB_PORT=5432
DB_NAME=embed_chat
DB_USER=postgres
DB_PASSWORD=change-me-strong-db-password

# ── Redis (compose의 redis 서비스) — Celery broker/result도 이 값을 쓴다 ──
REDIS_URL=redis://redis:6379/0

# ── EventBus(Redis Streams) 토픽 ──
EVENTS_TOPIC=events.session

# ── nginx 호스트 노출 포트 — NPM이 <A1 호스트>:이 포트로 포워딩한다 ──
# ⚠️ Oracle 보안목록엔 열지 말 것(같은 호스트의 NPM만 접근). 공개는 NPM의 443만.
NGINX_PORT=8080

# ── 선택(기본값 있음) ──
# 챗 토큰 스트리밍 킬스위치(기본 on). provider 호환 문제 시 false로 전면 끄기.
CHAT_STREAMING_ENABLED=true
# 공개 URL 레이트리밋(분당). 기본 visitor=20 / tenant=300.
CHAT_RATE_LIMIT_PER_VISITOR=20
CHAT_RATE_LIMIT_PER_TENANT=300

# 참고:
# - 이미지 태그(IMAGE_TAG)는 deploy.sh가 배포 SHA로 주입하므로 여기 두지 않는다.
# - prod는 PLATFORM_DEFAULT_PROVIDERS_ENABLED=False라 OPEN_ROUTER_*·OLLAMA_*·PADDLE_*가
#   불필요하다 — LLM·Embedding·OCR은 테넌트가 자기 Provider를 설정한다(ADR-0012).
